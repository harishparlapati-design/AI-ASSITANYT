{
  "appId": "com.harry.assistant",
  "appName": "Harry AI",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://REPLACE-WITH-YOUR-HARRY-HOST",
    "cleartext": false,
    "allowNavigation": []
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 800,
      "backgroundColor": "#0b1526"
    }
  }
}
